{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci --no-audit --no-fund",
  "buildCommand": "npm run build",
  "regions": ["icn1"],
  "crons": [
    {
      "path": "/api/cron/placement-notify",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/cleanup",
      "schedule": "0 19 * * *"
    },
    {
      "path": "/api/cron/hr-sync",
      "schedule": "0 */6 * * *"
    }
  ]
}
