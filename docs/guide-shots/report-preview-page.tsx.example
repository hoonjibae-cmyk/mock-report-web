import { notFound } from "next/navigation";
import OmrDashboard from "@/components/OmrDashboard";
import ExamSummary from "@/components/ExamSummary";
import GenericReport from "@/components/GenericReport";
import type { OmrExam } from "@/lib/omr-types";
import type { ExamSummaryData, SummaryRow } from "@/lib/exam-summary";
import type { GenericReportData, GenericItemResult } from "@/lib/omr-report-types";
import { EMPTY_REVIEW } from "@/lib/review";

export const dynamic = "force-dynamic";
const names = ["김예시", "이예시", "박예시"];
const examId = "6a3e8547-5e8f-4b20-8b2d-2fa4ec6636b9";
const title = "10월 월말평가 · 중2 예시반";
const areas = ["문법", "독해"];
const cohort = { count: 3, mean: 80, stdev: 8.2, max: 90, min: 70 };
const items: GenericItemResult[] = Array.from({ length: 20 }, (_, index) => ({
  no: index + 1, essay: false, answer: (index % 5) + 1,
  marked: index < 18 ? (index % 5) + 1 : ((index + 1) % 5) + 1,
  correct: index < 18, earned: index < 18 ? 5 : 0,
  point: 5, correctRate: index < 18 ? 85 : 35, difficulty: "보통",
  difficultySpecified: false, area: areas[index < 10 ? 0 : 1], content: null,
}));
const exam: OmrExam = {
  id: examId, examType: "monthly", reportFamily: "C_generic", title, subject: "영어",
  examDate: "2026-10-22", numQuestions: 20, numChoices: 5, idDigits: 5,
  omrStyle: "exam", omrConfig: { per_column: 20, essay_count: 0, subject_label: "영어 영역" },
  answerKey: Object.fromEntries(items.map((item) => [String(item.no), item.answer!])),
  points: {}, questionMeta: Object.fromEntries(items.map((item) => [String(item.no), { area: item.area! }])),
  mockReference: null, gradeCuts: [], useTeacherComment: true,
  createdByName: "김선생", createdByUsername: "teacher", createdAt: "2026-10-20T01:00:00.000Z",
  classNames: ["중2 예시반"], level: "중2", periodMonth: "2026-10", cohortMode: "class", review: EMPTY_REVIEW,
};
const rows: SummaryRow[] = names.map((name, index) => ({
  studentKey: `9000${index + 1}`, name, school: "예시중 2", className: "중2 예시반",
  raw: 90 - index * 10, max: 100, objectiveRaw: 90 - index * 10, essayRaw: 0,
  rank: index + 1, topPercent: (index + 1) / 3 * 100, standardScore: 124 - index * 24,
  grade: null, correctCount: 18 - index * 2, wrongCount: 2 + index * 2, blankCount: 0,
  areas: areas.map((area, areaIndex) => ({ area, earned: (areaIndex === 0 ? 50 : 40) - index * 5,
    possible: 50, rate: (areaIndex === 0 ? 100 : 80) - index * 10, estimated: false })),
  items: items.map((item) => ({ no: item.no, essay: false, correct: item.no <= 18 - index * 2,
    marked: String(item.no <= 18 - index * 2 ? item.answer : 3),
    earned: item.no <= 18 - index * 2 ? 5 : 0, point: 5, absent: false })),
  reportToken: `guide-fictional-${index}`, listeningAbsent: false,
}));
const summary: ExamSummaryData = {
  examId, title, typeLabel: "월말평가", examDate: "2026-10-22", numQuestions: 20,
  essayCount: 0, max: 100, classNames: ["중2 예시반"], cohort,
  questions: items.map((item) => ({ no: item.no, essay: false, answer: String(item.answer),
    area: item.area!, point: 5, rate: item.correctRate })),
  rows, pendingScans: 0, reportCount: 3, listening: null, answerKeyComplete: true,
  directoryError: null, generatedAt: "2026-10-26T06:00:00.000Z",
};
const report: GenericReportData = {
  schemaVersion: 2, family: "C_generic", examId, examType: "monthly", examTypeLabel: "월말평가",
  examTitle: title, examDate: "2026-10-22", academy: "목동유쌤영어학원",
  student: { key: "90001", name: "김예시", school: "예시중 2", className: "중2 예시반" },
  score: { raw: 90, objectiveRaw: 90, essayRaw: 0, max: 100, correctCount: 18,
    wrongCount: 2, blankCount: 0, totalQuestions: 20 },
  cohort, cohortScope: "class", cohortLabel: "반 평균", standardScore: 124, rank: 1,
  topPercent: 33.3, grade: null, items,
  areas: areas.map((area, index) => ({ area, earned: index === 0 ? 50 : 40,
    possible: 50, rate: index === 0 ? 100 : 80, cohortRate: index === 0 ? 90 : 70,
    cohortEarned: index === 0 ? 45 : 35 })),
  weakItems: [19, 20], growth: [], essayCount: 0,
  teacherComment: { text: "문법의 기초를 잘 이해하고 있습니다. 독해에서는 문장 간 연결 관계를 확인하는 연습을 이어 가세요." },
  appVersion: "1.55.0", generatedAt: "2026-10-26T06:00:00.000Z",
};

export default async function ReportPreviewShots({ searchParams }: {
  searchParams: Promise<{ screen?: string }>;
}) {
  if (process.env.NODE_ENV !== "development") notFound();
  const { screen = "list" } = await searchParams;
  if (screen === "summary") return <ExamSummary data={summary} canExport />;
  if (screen === "report") return <><style>{"nextjs-portal{display:none}"}</style><GenericReport report={report} comments={{
    overview: "이번 월말평가는 문법 개념과 독해 능력을 함께 확인했습니다.",
    personal: report.teacherComment!.text, keywords: ["기초 개념 이해", "성실한 학습"], style: "free",
  }} /></>;
  return <OmrDashboard initialExams={[exam]} setupError="" activeType={null}
    omrServiceReady canCreate canDelete={false}
    currentUser={{ username: "teacher", displayName: "김선생", role: "admin" }} />;
}
